# Control Flow
module app.control

fn abs(n: s32): s32 {
    if (n < 0) {
        return -n;
    }
    return n;
}

fn max(a: s32, b: s32): s32 {
    if (a > b) {
        return a;
    }
    else {
        return b;
    }
}

fn factorial(n: s32): s32 {
    var result: s32 = 1;
    for var i: s32 = 1; i <= n; i = i + 1 {
        result = result * i;
    }
    return result;
}

fn main(): s32 {
    var x: s32 = abs(-42);
    var m: s32 = max(10, 20);
    var f: s32 = factorial(5);
    return x + m + f;
}
