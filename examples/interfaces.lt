# Interface Inheritance
# Demonstrates interface extending other interfaces to build complex contracts.

export interface Readable {
    read(buf: *u8, len: usize): ssize;
}

export interface Writable {
    write(buf: *u8, len: usize): ssize;
}

# An interface can extend multiple other interfaces
export interface Stream extends Readable, Writable {
    flush(): s32;
    close(): s32;
}

# A module implements the full contract
export module FileStream implements Stream {
    static fn open(path: *u8): FileStream {
        # Factory — returns a new FileStream
    }

    fn read(buf: *u8, len: usize): ssize {
        return 0;
    }

    fn write(buf: *u8, len: usize): ssize {
        return 0;
    }

    fn flush(): s32 {
        return 0;
    }

    fn close(): s32 {
        return 0;
    }
}
