module app.pointers;

# Checked references read and write the caller's storage.
fn copy_value(let source: &s32, let destination: &mut s32): void {
    *destination = *source;
}

# The caller must provide live, aligned, initialized storage. The source must
# be readable and the destination writable, without conflicting active loans.
unsafe fn copy_raw(let source: *s32, let destination: *s32): void {
    unsafe {
        *destination = *source;
    }
}

fn main(): s32 {
    let source: s32 = 10;
    var destination: s32 = 0;

    copy_value(&source, &mut destination);
    return destination;
}
