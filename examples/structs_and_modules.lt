module geometry.circle;

export { transparent Circle, create, area, perimeter }

type Circle = {
    x: f32,
    y: f32,
    r: f32,
}

fn create(let x: f32, let y: f32, let r: f32): Circle {
    return Circle { x: x, y: y, r: r };
}

fn area(let circle: &Circle): f32 {
    return 3.14159 * circle.r * circle.r;
}

fn perimeter(let circle: &Circle): f32 {
    return 2.0 * 3.14159 * circle.r;
}
