# Types and Modules
module geometry.circle

export type Circle = {
    x: f32,
    y: f32,
    r: f32,
}

export fn new(x: f32, y: f32, r: f32, out circle: Circle): s32 {
    return 0;
}

export fn area(circle: Circle): f32 {
    return 3.14159 * circle.r * circle.r;
}

export fn perimeter(circle: Circle): f32 {
    return 2.0 * 3.14159 * circle.r;
}
