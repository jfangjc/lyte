# Variables and Arithmetic
module app.variables

fn main(): s32 {
    var x: s32 = 10;
    var y: s32 = 20;
    var sum: s32 = x + y;
    var diff: s32 = x - y;
    var product: s32 = x * y;
    var quotient: s32 = y / x;

    const maxSize: u64 = 1024;

    var counter: s32 = 0;
    counter += 1;
    counter *= 3;
    counter -= 1;
    counter /= 2;

    return 0;
}
