module app.variables;

# A typed module-level let is a compile-time constant.
let max_size: u64 = 1024;

fn main(): s32 {
    let x: s32 = 10;
    let y: s32 = 20;
    let sum = x + y;
    let diff = x - y;
    let product = x * y;
    let quotient = y / x;

    var counter: s32 = 0;
    counter += 1;
    counter *= 3;
    counter -= 1;
    counter /= 2;

    return 0;
}
